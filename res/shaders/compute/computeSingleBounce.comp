#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout (rgba32f, binding = 0) uniform image2D imgOutput;

#include "src/deviceShared/BufferBindings.h"

layout (std430, binding = POS_BUFFER_TARGET) buffer positionBuffer
{
    vec4 posData[];
};

layout (std430, binding = DIR_BUFFER_TARGET) buffer directionBuffer
{
    vec4 dirData[];
};

layout (std430, binding = MULT_BUFFER_TARGET) buffer multiplierData
{
    vec4 mulData[];
};

uniform vec2 frameSeed;
uniform float alphaRR;

uniform int width;
uniform int height;

uniform uint seed;

#include "res/shaders/scenes/CPUScene.glsl"
#include "res/shaders/utils/rayTraceUtils.glsl"
#include "res/shaders/utils/MeshTypes.glsl"
#include "res/shaders/utils/RayTypes.glsl"
#include "res/shaders/utils/FlagUtils.glsl"
#include "src/deviceShared/MaterialFlags.h"
#include "res/shaders/lighting/Lighting.glsl"
#include "res/shaders/utils/Constants.glsl"

void main() {
    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    ivec2 bufferCoords = ivec2(texelCoord);

    int singleDimCoord = bufferCoords.y * width + bufferCoords.x;


    vec4 mulBufVal = mulData[singleDimCoord];
    vec3 mul = mulBufVal.xyz;

    if (length(mul) < EPS_4) {
        return;
    }

    vec3 pos = posData[singleDimCoord].xyz;
    vec3 dir = dirData[singleDimCoord].xyz;

    uint instanceSeed = triple32(floatBitsToUint(seed) + triple32(singleDimCoord));

    mul /= alphaRR;

    Ray ray = Ray(pos, dir);

    RayHit rayHit;
    bool hit = getClosestHit(ray, rayHit);

    vec3 test = vec3(1);

    if (!hit) {
        // TODO when present, evaluate environment map

        /*
        vec4 prevBufferContent = imageLoad(imgOutput, bufferCoords);

        float dotVal = dot(dir, vec3(0, 1, 0));
        vec3 skyColor = vec3(0.13, 0.02, 0.85);
        vec3 groundColor = vec3(0.07, 0.54, 0.04);

        float interpolator = (dotVal * 10 + 1) / 2;
        vec3 envColor = mix(groundColor, skyColor, interpolator);

        vec4 newValue = prevBufferContent + vec4(envColor, 1) * vec4(mul, 1);

        imageStore(imgOutput, bufferCoords, newValue);
        */

        // imageStore(imgOutput, bufferCoords, vec4(test, 1));

        posData[singleDimCoord] = vec4(ray.origin + 10000 * ray.direction, 0);
        mulData[singleDimCoord] = vec4(0);
        return;
    }

    Ray newRay;
    bool hasDirect = false;
    vec3 directColor = vec3(0);

    LightingSettings lightingSettings;

    BufferMaterial mat = materials[rayHit.matID];

    bool doNEE = randUniform_0_1(instanceSeed) < mat.roughness;

    lightingSettings.evaluateDirect = mulBufVal.a > 0;
    lightingSettings.evaluateNEE = doNEE;
    newRay.origin = vec3(0);
    newRay.direction = vec3(1, 0, 0);
    evaluateLighting(ray, rayHit, lightingSettings, mul, instanceSeed, newRay, hasDirect, directColor);

    const bool debug = false;

    if (debug) {
        vec3 debugColor = vec3(1);
        vec4 newValue = vec4(debugColor, 1);

        imageStore(imgOutput, bufferCoords, newValue);

        posData[singleDimCoord] = vec4(0);
        dirData[singleDimCoord] = vec4(0);
        mulData[singleDimCoord] = vec4(0);
        return;
    }

    if (hasDirect) {
        vec4 prevBufferContent = imageLoad(imgOutput, bufferCoords);

        float cutoff = 50;
        if (length(directColor) < cutoff) {
            vec4 newValue = prevBufferContent + vec4(directColor, 0);

            imageStore(imgOutput, bufferCoords, newValue);
        }
    }

    posData[singleDimCoord] = newRay.origin.xyzz; // newPos.xyzz;
    dirData[singleDimCoord] = newRay.direction.xyzz; // newDir.xyzz;
    mulData[singleDimCoord] = vec4(mul, doNEE ? 0 : 1);
}