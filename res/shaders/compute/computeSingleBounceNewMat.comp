#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout (rgba32f, binding = 0) uniform image2D imgOutput;

#include "src/deviceShared/BufferBindings.h"

layout(std430, binding = POS_BUFFER_TARGET) buffer positionBuffer
{
    vec4 posData[];
};

layout(std430, binding = DIR_BUFFER_TARGET) buffer directionBuffer
{
    vec4 dirData[];
};

layout(std430, binding = MULT_BUFFER_TARGET) buffer multiplierData
{
    vec4 mulData[];
};

uniform vec2 frameSeed;
uniform float alphaRR;

uniform int width;
uniform int height;

uniform uint seed;

#include "res/shaders/scenes/CPUScene.glsl"
#include "res/shaders/utils/rayTraceUtils.glsl"
#include "res/shaders/utils/MeshTypes.glsl"
#include "res/shaders/utils/RayTypes.glsl"
#include "res/shaders/utils/FlagUtils.glsl"
#include "src/deviceShared/MaterialFlags.h"

#include "res/shaders/utils/samplingUtils.glsl"
#include "res/shaders/material/microFacetModels.glsl"

void main() {
    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    ivec2 bufferCoords = ivec2(texelCoord);

    const float eps = 1e-4;

    int singleDimCoord = bufferCoords.y * width + bufferCoords.x;

    vec3 mul = mulData[singleDimCoord].xyz;

    if (length(mul) < eps) {
        return;
    }

    vec3 pos = posData[singleDimCoord].xyz;
    vec3 dir = dirData[singleDimCoord].xyz;

    uint instanceSeed = triple32(floatBitsToUint(seed) + triple32(singleDimCoord));

    mul /= alphaRR;

    Ray ray = Ray(pos, dir);
    float dist;

    RayHit rayHit;
    bool hit = getClosestHit(ray, rayHit);

    if (!hit) {
        posData[singleDimCoord] = vec4(ray.origin + 10000 * ray.direction, 0);
        mulData[singleDimCoord] = vec4(0);
        return;
    }

    vec3 newPos = rayHit.position;
    vec3 N = rayHit.hitBackface ? -rayHit.normal : rayHit.normal;
    uint matProperties = floatBitsToUint(rayHit.mat.color.w);

    vec3 newDir = vec3(0);
    if (checkBitFlag(matProperties, EMISSIVE_FLAG)) {
        const vec3 LIGHT_INTENSITY = vec3(15);

        vec3 color = mul * LIGHT_INTENSITY;
        vec4 prevBufferContent = imageLoad(imgOutput, bufferCoords);
        vec4 newValue = prevBufferContent + vec4(color, 0);

        imageStore(imgOutput, bufferCoords, newValue);
        mul = vec3(0);
    } else /* Diffuse */ {
        MaterialTMP mat;
        mat.albedo = rayHit.mat.color.xyz;
        mat.roughness = 0.01f;
        mat.metallic = 0.0f;

        float pdf = 1;
        vec3 brdf = evaluateBRDF(dir, N, newDir, pdf, instanceSeed, mat);

        float newDirLambert = max(0.0f, dot(N, newDir));
        mul *= newDirLambert * brdf / pdf;
    }

    newPos += eps * newDir;
    const bool debug = false;

    if (debug) {
        vec3 debugColor = vec3(1); //vec3(randUniform_0_1(instanceSeed), randUniform_0_1(instanceSeed), randUniform_0_1(instanceSeed));
        vec4 newValue = vec4(debugColor, 1);

        imageStore(imgOutput, bufferCoords, newValue);

        posData[singleDimCoord] = vec4(1, 0, 1, 1);
        dirData[singleDimCoord] = vec4(newDir.xyz, 1);
        mulData[singleDimCoord] = vec4(0);
        return;
    }

    posData[singleDimCoord] = newPos.xyzz;
    dirData[singleDimCoord] = newDir.xyzz;
    mulData[singleDimCoord] = mul.xyzz;
}