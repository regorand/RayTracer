#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout (rgba32f, binding = 0) uniform image2D imgOutput;

#include "src/deviceShared/BufferBindings.h"

layout(std430, binding = POS_BUFFER_TARGET) buffer positionBuffer
{
    vec4 posData[];
};

layout(std430, binding = DIR_BUFFER_TARGET) buffer directionBuffer
{
    vec4 dirData[];
};

layout(std430, binding = MULT_BUFFER_TARGET) buffer multiplierData
{
    vec4 mulData[];
};

uniform vec2 frameSeed;
uniform vec2 viewPortSize;

uniform int width;

uniform vec3 cameraPos;
uniform vec3 viewDir;
uniform vec3 upDir;

uniform float fov;
uniform float aspect;

#include "res/shaders/utils/cameraUtils.glsl"

void main() {
    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    ivec2 bufferCoords = ivec2(texelCoord);

    int singleDimCoord = bufferCoords.y * width + bufferCoords.x;

    Ray ray = samplePathStart(texelCoord, viewPortSize);

    vec4 bufferContent = imageLoad(imgOutput, bufferCoords);
    bufferContent.a += 1;
    imageStore(imgOutput, bufferCoords, bufferContent);

    posData[singleDimCoord] = vec4(ray.origin, 1);
    dirData[singleDimCoord] = vec4(ray.direction, 1);
    mulData[singleDimCoord] = vec4(vec4(1));
}
