#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D imgOutput;

uniform vec2 frameSeed;


#include "res/shaders/utils/sampleSceneDescr.glsl"
#include "res/shaders/utils/samplingUtils.glsl"
#include "res/shaders/utils/rayTraceUtils.glsl"

void main() {
    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);

    Ray ray = samplePathStart(texelCoord);

    vec3 color = raytrace(ray);
    vec4 outVal = vec4(color, 1);

    imageStore(imgOutput, ivec2(texelCoord), outVal);
}