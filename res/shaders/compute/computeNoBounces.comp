bool castShadowRay(vec3 point, vec3 lightPos) {
    Ray ray;
    vec3 unnormToLight = lightPos - point;
    float distToLight = length(unnormToLight);
    ray.direction = unnormToLight / distToLight;
    float eps = 1e-1;
    ray.origin = point + eps * ray.direction;

    for (int i = 0; i < 5; i++) {
        float dist;
        bool hit = intersectSphere(ray, spheres[i], dist);
        if (hit && dist < distToLight) return true;
    }
    return false;
}

vec3 shade(Ray ray, Sphere sphere, float hitDist) {
    const vec3 lightPos = vec3(15, 15, -15);
    const vec3 lightColor = vec3(1, 1, 1);
    const float lightIntensity = 1000;

    vec3 L = normalize(lightPos - sphere.center);
    vec3 hitPos = ray.origin + hitDist * ray.direction;
    vec3 N = normalize(hitPos - sphere.center);

    float lightDist = distance(hitPos, lightPos);

    float shadow = castShadowRay(hitPos, lightPos) ? 0 : 1;

    float factor = clamp(dot(L, N), 0.0, 1.0);

    vec3 matColor = sphere.mat.color * (lightIntensity * lightColor / (lightDist * lightDist));
    float ambientFac = 0.1;


    return shadow * factor * (1-ambientFac) * matColor + ambientFac * matColor;
}

bool getClosestHit(Ray ray, out Sphere closestSphere, out float dist) {
    float closest = 1000000;
    bool anyHit = false;
    int closestIndex = -1;

    for (int i = 0; i < 5; i++) {
        float dist;
        bool hit = intersectSphere(ray, spheres[i], dist);
        if (hit && dist > 0) {
            anyHit = true;
            if (dist < closest) {
                closest = dist;
                closestIndex = i;
            }
        }
    }
    if (anyHit) {
        closestSphere = spheres[closestIndex];
        dist = closest;
    }
    return anyHit;
}



void main() {
    float fov = PI / 2;
    float aspect = 9.0/16.0;

    float sideDist = tan(fov / 2);
    float upDist = sideDist * aspect;

    const vec3 camDir = vec3(0, 0, -1);
    const vec3 upDir = vec3(0, 1, 0);
    const vec3 tanDir = cross(camDir, upDir);

    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    vec2 halfSizes = vec2(gl_NumWorkGroups.xy / 2);

    vec2 shiftedScaled = (texelCoord - halfSizes) / halfSizes;
    Ray ray;
    ray.origin = vec3(0, 0, 35);
    ray.direction = normalize(camDir + upDist * shiftedScaled.y * upDir + sideDist * shiftedScaled.x * tanDir);

    // Sphere spheres[5] = getSampleScene();
    Sphere hitSphere;
    float dist;
    bool hit = getClosestHit(ray, hitSphere, dist);

    vec3 color = vec3(0);
    if (hit) {

        color += hitSphere.mat.diffuse * shade(ray, hitSphere, dist);
        float specular = (1 - hitSphere.mat.diffuse);

        Ray outRay;
        outRay.origin = ray.origin + dist * ray.direction;
        vec3 N = normalize(outRay.origin - hitSphere.center);
        outRay.direction = reflect(ray.direction, N);
        hit = getClosestHit(outRay, hitSphere, dist);
        if (hit) {
            color += specular * shade(outRay, hitSphere, dist);
        }


    }
    vec4 outVal = vec4(color, 1);
    /*
    float dist;
    bool hit =  intersectSphere(ray, sphere, dist);

    vec4 value = vec4(vec3(0.0), 1.0);
    if (hit) {
        value = vec4(sphere.color, 1);
    }
    */

    imageStore(imgOutput, ivec2(texelCoord), outVal);
}