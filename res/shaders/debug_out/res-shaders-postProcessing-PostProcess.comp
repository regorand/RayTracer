#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;


// Included from res/shaders/postProcessing/PostProcessingUtils.glsl
void applyGammaCorrection(inout vec3 value) {
    value = pow(value, vec3(1 / 2.2));
}

void applyReinhardToneMapping(inout vec3 value) {
    value = value / (value + 1);
}

// End Includeres/shaders/postProcessing/PostProcessingUtils.glsl

// Included from res/shaders/utils/FlagUtils.glsl
bool checkBitFlag(uint value, uint bitFlag) {
    return (value & bitFlag) != 0;
}

// End Includeres/shaders/utils/FlagUtils.glsl


// Included from src/deviceShared/PostProcessFlags.h
#ifdef __cplusplus
#pragma once
#endif

#define GAMMA_CORRECT (1)
#define TONEMAP (1 << 1)

// End Includesrc/deviceShared/PostProcessFlags.h

uniform uint postProcessFlags;

layout (rgba32f, binding = 0) uniform image2D renderBuffer;

layout (rgba32f, binding = 1) uniform image2D outputBuffer;

void main() {
    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    ivec2 bufferCoords = ivec2(texelCoord);

    vec4 bufferColor = imageLoad(renderBuffer, bufferCoords);
    vec3 color = bufferColor.rgb / bufferColor.a;
    if (checkBitFlag(postProcessFlags, GAMMA_CORRECT)) {
        applyGammaCorrection(color);
    }

    if (checkBitFlag(postProcessFlags, TONEMAP)) {
        applyReinhardToneMapping(color);
    }

    imageStore(outputBuffer, bufferCoords, vec4(color, 1));
}
