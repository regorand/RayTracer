#version 430 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (rgba32f, binding = 0) uniform image2D imgOutput;

uniform int width;
uniform int height;

uniform uint seed;

uniform vec3 cameraPos;
uniform vec3 viewDir;
uniform vec3 upDir;

uniform float fov;
uniform float aspect;

#include "res/shaders/utils/cameraUtils.glsl"
#include "res/shaders/utils/rayTraceUtils.glsl"

void main() {
    if (gl_GlobalInvocationID.x >= width || gl_GlobalInvocationID.y >= height) return;

    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    int singleDimCoord = int(gl_GlobalInvocationID.y * width + gl_GlobalInvocationID.x);

    uint instanceSeed = triple32(seed + triple32(singleDimCoord));

    vec2 viewPortSize = vec2(width, height);
    Ray ray = samplePathStart(texelCoord, viewPortSize, instanceSeed);

    int count = countBVHHits(ray);
    int denom = 50; // TODO some better normalization constant


    imageStore(imgOutput, ivec2(gl_GlobalInvocationID.xy), vec4(vec3(count) / denom, 1));
}
