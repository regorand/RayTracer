#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "res/shaders/postProcessing/PostProcessingUtils.glsl"
#include "res/shaders/utils/FlagUtils.glsl"

#include "src/deviceShared/PostProcessFlags.h"

uniform uint postProcessFlags;

layout (rgba32f, binding = 0) uniform image2D renderBuffer;

layout (rgba32f, binding = 1) uniform image2D outputBuffer;

void main() {
    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    ivec2 bufferCoords = ivec2(texelCoord);

    vec4 bufferColor = imageLoad(renderBuffer, bufferCoords);
    vec3 color = bufferColor.rgb / bufferColor.a;

    if (checkBitFlag(postProcessFlags, GAMMA_CORRECT_BIT_FLAG)) {
        GammaCorrection(color);
    }

    if (checkBitFlag(postProcessFlags, TONEMAP_BIT_FLAG)) {
        // TODO better tonemapping accounting for global average luminosty
        // https://bruop.github.io/tonemapping/

        float whiteVal = 2.0f;
        // Reinhard(color);
        ReinhardWhiteVal(whiteVal, color);
    }

    imageStore(outputBuffer, bufferCoords, vec4(color, 1));
}