#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

uniform int halfKernelSize;

layout (rgba32f, binding = 0) uniform image2D renderBuffer;

layout (rgba32f, binding = 1) uniform image2D outputBuffer;

void main() {
    vec3 sum = vec3(0);

    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    ivec2 bufferCoords = ivec2(texelCoord);

    for (int x = - halfKernelSize; x <= halfKernelSize; x++) {
        for (int y = - halfKernelSize; y <= halfKernelSize; y++) {
            vec4 bufferColor = imageLoad(renderBuffer, bufferCoords + ivec2(x, y));
            sum += bufferColor.rgb / bufferColor.a;
        }
    }

    vec3 outColor = sum / pow(2 * halfKernelSize + 1, 2);

    imageStore(outputBuffer, bufferCoords, vec4(outColor, 1));
}