#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "res/shaders/utils/Constants.glsl"

uniform int halfKernelSize;
// uniform float standardDev;

layout (rgba32f, binding = 0) uniform image2D renderBuffer;

layout (rgba32f, binding = 1) uniform image2D outputBuffer;

void main() {
    vec3 sum = vec3(0);

    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);
    ivec2 bufferCoords = ivec2(texelCoord);

    int N = 2 * halfKernelSize + 1;
    float standardDev = 0.3 * ((N - 1) * 0.5 - 1) + 0.8;
    float twoVariance = 2 * pow(standardDev, 2);

    float weightSum = 0;

    for (int x = -halfKernelSize; x <= halfKernelSize; x++) {
        for (int y = -halfKernelSize; y <= halfKernelSize; y++) {
            vec4 bufferColor = imageLoad(renderBuffer, bufferCoords + ivec2(x, y));
            float weight = 1 / (PI * twoVariance) * exp(-(pow(x, 2) + pow(y, 2)) / twoVariance);
            weightSum += weight;
            sum += weight * bufferColor.rgb;
        }
    }

    // imageStore(outputBuffer, bufferCoords, vec4(vec3(weightSum * 3), 1));
    imageStore(outputBuffer, bufferCoords, vec4(sum / weightSum, 1));
}