#version 430 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (rgba32f, binding = 0) uniform image2D imgOutput;

uniform int width;
uniform int height;

uniform uint seed;

uniform vec3 cameraPos;
uniform vec3 viewDir;
uniform vec3 upDir;

uniform float fov;
uniform float aspect;

uniform bool doBrdf;
uniform bool doNee;

uniform int maxBounces;

uniform bool doRR;
uniform float alphaRR;

#include "res/shaders/scenes/CPUScene.glsl"
#include "res/shaders/utils/rayTraceUtils.glsl"
#include "res/shaders/utils/MeshTypes.glsl"
#include "res/shaders/utils/RayTypes.glsl"
#include "res/shaders/utils/FlagUtils.glsl"
#include "src/deviceShared/MaterialFlags.h"
#include "res/shaders/utils/Constants.glsl"
#include "res/shaders/utils/cameraUtils.glsl"
#include "res/shaders/material/BSDF.glsl"
#include "res/shaders/lighting/NEE.glsl"

void main() {
    vec2 texelCoord = vec2(gl_GlobalInvocationID.xy);

    ivec2 bufferCoords = ivec2(texelCoord);
    if (bufferCoords.x >= width || bufferCoords.y >= height) return;

    int singleDimCoord = bufferCoords.y * width + bufferCoords.x;

    uint instanceSeed = triple32(seed + triple32(singleDimCoord));

    vec2 viewPortSize = vec2(width, height);
    Ray ray = samplePathStart(texelCoord, viewPortSize, instanceSeed);

    int bounces = 0;

    vec3 L = vec3(0);
    vec3 Lw = vec3(1);

    bool doNext = true;

    vec3 brdfContrib = vec3(0);
    float prevBrdfMISWeight = 1.0;
    float neeWeight = 0;
    while (doNext && bounces <= maxBounces) {
        RayHit rayHit;
        bool hit = getClosestHit(ray, rayHit);

        if (!hit) {
            break;
        }

        Material mat = materials[rayHit.matID];

        if ((doBrdf || bounces == 0) && isEmissive(mat)) {
            brdfContrib = Lw * prevBrdfMISWeight * mat.emission.xyz;
            doNext = false;
        }

        vec3 N = rayHit.normal;

        vec3 newPos;
        Sample smpl = BSDF_Sample(ray.direction, N, mat, rayHit.hitBackface, instanceSeed);

        newPos = rayHit.position + EPS_5 * smpl.newDir;

        vec3 contribNEE = vec3(0);
        float pdfNEE = 0.0f;
        if (doNee) {
            sampleLightsourceNEE(newPos, N, ray.direction, mat, instanceSeed, contribNEE, pdfNEE);
        }

        float beta = 3;
        // MIS Balance Heuristic
        neeWeight = doNee ? pow(pdfNEE, beta) : 0.0f;
        prevBrdfMISWeight = doBrdf ? pow(smpl.pdf, beta) : 0.0f;

        float weightSum = neeWeight + prevBrdfMISWeight;

        if (weightSum > 0) {
            prevBrdfMISWeight /= weightSum;
            neeWeight /= weightSum;
        }

        L += brdfContrib + Lw * neeWeight * contribNEE;
        // L = vec3(smpl.pdf.xxx);
        // L = smpl.newDir - ray.direction;
        // L = smpl.brdf;

        // create new ray
        ray.direction = smpl.newDir;
        ray.origin = newPos;

        float newDirLambert = dot(N, ray.direction);
        Lw *= newDirLambert * smpl.brdf / smpl.pdf;

        if (doRR) {
            doNext = randUniform_0_1(instanceSeed) < alphaRR;
            Lw /= alphaRR ;
        }

        bounces++;
    }

    // if (any(isnan(L))) L = vec3(10000);
    if (any(isnan(L))) return;
    if (length(L) > 300) return;

    vec4 prevBufferContent = imageLoad(imgOutput, bufferCoords);
    imageStore(imgOutput, bufferCoords, prevBufferContent + vec4(L, 1));
}